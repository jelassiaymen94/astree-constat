# SQL Server
SQLSERVER_SA_PASSWORD=ChangeThis_StrongPassword123!
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AstreeClaimsDb;User Id=sa;Password=ChangeThis_StrongPassword123!;TrustServerCertificate=True

# FastAPI
AI_SERVICE_BASE_URL=http://localhost:8000

# LLM — conserver deterministic pour les tests sans réseau
